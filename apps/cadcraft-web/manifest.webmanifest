{
  "name": "VNCCad",
  "short_name": "VNCCad",
  "description": "Phần mềm vẽ kỹ thuật kiểu AutoCAD, chạy trên trình duyệt và offline (dựa trên CADCraft, MIT/Apache-2.0)",
  "lang": "vi",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#22282f",
  "theme_color": "#22282f",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/dxf": [".dxf"], "image/vnd.dwg": [".dwg"] } }
  ]
}
